    "preferred_indicator": "Konsili Pivot Exporter",
    "required_exporter": {
      "name": "Konsili Pivot Exporter",
      "version": 2,
      "study_filter": "Konsili Pivot Exporter",
      "pine_script": "tradingview/konsili_pivot_exporter.pine",
      "row_prefix": "KPE",
      "required_row_fields": [
        "date",
        "time",
        "price"
      ],
      "required_pivot_fields": [
        "date",
        "time",
        "price"
      ],
      "price_tolerance_abs": 0.000001,
      "allowed_source_tools": [
        "data_get_pine_tables",
        "data_get_pine_labels"
      ],
      "visual_label_contract": {
        "default_label_mode": "Price + date",
        "fallback_label_mode": "Price + date + KPE",
        "default_table_visible": false,
        "table_use": "fallback_only_when_visual_inspection_fails",
        "required_visible_fields": [
          "price",
          "date",
          "time"
        ]
      },
      "description": "Pivots must be visually readable first as wave-anchor labels: the visible Konsili Pivot Exporter labels sit on price-wave extremes and show price plus date/time on-chart. The structured KPE table is hidden by default and shown only when visual inspection is unavailable or ambiguous. Confirm visibility with data_get_indicator, not chart_get_state alone. Each accepted pivot must carry date, time, and price copied from the visual label or fallback exporter row."
    },
