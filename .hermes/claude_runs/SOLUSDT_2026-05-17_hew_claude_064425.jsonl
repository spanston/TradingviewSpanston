nly prose.\"\n  },\n  \"execution_quality_protocol\": {\n    \"path\": \"execution_quality\",\n    \"allowed_statuses\": [\n      \"pass\",\n      \"scheduled\",\n      \"not_required\"\n    ],\n    \"required_items\": [\n      {\n        \"id\": \"visual_qa\",\n        \"required_fields\": [\n          \"issues\"\n        ],\n        \"required_true_fields\": [\n          \"final_chart_stands_alone\",\n          \"sidebars_hidden\",\n          \"exporter_hidden_in_presentation\",\n          \"zone_labels_visible\",\n          \"zone_price_ranges_visible\",\n          \"zone_scores_visible\",\n          \"elliott_labels_readable\",\n          \"audit_screenshots_marked_audit_only\"\n        ]\n      },\n      {\n        \"id\": \"vision_qa\",\n        \"required_fields\": [\n          \"evidence\"\n        ],\n        \"required_true_fields\": [\n          \"screenshot_reviewed\"\n        ]\n      },\n      {\n        \"id\": \"rerun_schedule\",\n        \"required_fields\": [\n          \"condition\",\n          \"cadence\",\n          \"evidence\"\n        ]\n      },\n      {\n        \"id\": \"drawing_spec\",\n        \"required_fields\": [\n          \"source\",\n          \"evidence\"\n        ],\n        \"required_true_fields\": [\n          \"manifest_roles_checked\"\n        ]\n      }\n    ],\n    \"description\": \"Packages must record visual QA, rerun conditions, and manifest-driven drawing-spec compliance.\"\n  },\n  \"allowed\": {\n    \"chart_mode_statuses\": [\n      \"pass\",\n      \"pass_with_fallback\"\n    ],\n    \"checklist_statuses\": [\n      \"pass\",\n      \"pass_with_fallback\",\n      \"not_applicable\"\n    ],\n    \"stage_gate_statuses\": [\n      \"pass\",\n      \"pass_with_fallback\",\n      \"not_applicable\"\n    ],\n    \"pivot_verification_statuses\": [\n      \"pass\",\n      \"pass_with_fallback\"\n    ],\n    \"gate_statuses\": [\n      \"pass\",\n      \"pass_with_fallback\",\n      \"partial\",\n      \"fail\",\n      \"not_applicable\",\n      \"not_requested\"\n    ]\n  },\n  \"hew_structure_context_protocol\": {\n    \"path\": \"hew_structure_context\",\n    \"allowed_statuses\": [\n      \"pass\",\n      \"pass_with_fallback\"\n    ],\n    \"required_items\": [\n      {\n        \"id\": \"preceding_impulse_context\",\n        \"required_drawing_role\": \"preceding_impulse_context\",\n        \"description\": \"The impulse that produced the macro ABC/correction is drawn or the package fails.\"\n      },\n      {\n        \"id\": \"primary_degree_subwaves\",\n        \"required_drawing_role\": \"primary_degree_subwaves\",\n        \"description\": \"Primary-degree subwaves are visible with native Elliott tools.\"\n      },\n      {\n        \"id\": \"secondary_degree_subwaves\",\n        \"required_drawing_role\": \"secondary_degree_subwaves\",\n        \"description\": \"Secondary/internal subwaves are visible with native Elliott tools.\"\n      },\n      {\n        \"id\": \"forward_impulse_projection\",\n        \"required_drawing_role\": \"projection_count\",\n        \"requires_conditionality\": true,\n        \"description\": \"Completed 1-5 + ABC maps include a conditional forward impulse projection, not a factual prediction.\"\n      }\n    ]\n  },\n  \"copsey_purity_protocol\": {\n    \"path\": \"copsey_hew_purity\",\n    \"allowed_statuses\": [\n      \"pass\",\n      \"pass_with_fallback\",\n      \"not_applicable\",\n      \"rare_exception_downgraded\"\n    ],\n    \"required_items\": [\n      \"internal_abc_motive_engines\",\n      \"ac_lower_degree_fives\",\n      \"classical_rescue_devices\",\n      \"castaway_overlay\",\n      \"wave3_1764_rule\"\n    ],\n    \"internal_abc_motive_engines\": {\n      \"required_macro_waves\": [\n        \"1\",\n        \"3\",\n        \"5\"\n      ],\n      \"allowed_coverage_statuses\": [\n        \"visible\",\n        \"visible_equivalent\"\n      ],\n      \"description\": \"Macro Waves 1, 3, and 5 must identify internal A-B-C motive engines or explicit visible equivalents.\"\n    },\n    \"ac_lower_degree_fives\": {\n      \"required_legs\": [\n        \"A\",\n        \"C\"\n      ],\n      \"visible_statuses\": [\n        \"visible\",\n        \"pass\"\n      ],\n      \"not_visible_statuses\": [\n        \"not_visible\",\n        \"not_applicable\"\n      ],\n      \"description\": \"A and C legs need lower-degree five-wave action where visible; if not visible, record downgrade semantics.\"\n    },\n    \"classical_rescue_devices\": {\n      \"expected_rejected_devices\": [\n        \"extended_waves\",\n        \"failed_fifths\",\n        \"leading_diagonals\",\n        \"ending_diagonals\",\n        \"diagonal_triangles\"\n      ],\n      \"description\": \"Classical Elliott rescue devices are rejected for Copsey HEW purity.\"\n    },\n    \"castaway_overlay\": {\n      \"required_terms\": [\n        \"konsili\",\n        \"castaway\",\n        \"overlay\"\n      ],\n      \"forbidden_terms\": [\n        \"copsey source\",\n        \"source: copsey\",\n        \"copsey-derived\"\n      ],\n      \"description\": \"Castaway is a Konsili/Castaway overlay and must not be labeled as a Copsey source.\"\n    },\n    \"wave3_1764_rule\": {\n      \"ratio_validation_id\": \"wave3_1764_rule\",\n      \"minimum_ratio\": 1.764,\n      \"allowed_statuses\": [\n        \"pass\",\n        \"pass_with_fallback\",\n        \"rare_exception_downgraded\"\n      ],\n      \"exception_statuses\": [\n        \"rare_exception_downgraded\"\n      ],\n      \"exception_required_fields\": [\n        \"rarity\",\n        \"documentation\",\n        \"downgrade\",\n        \"resulting_posture\"\n      ],\n      \"description\": \"Wave 3 must reach at least 176.4% of Wave 1; rare exceptions require documentation and a downgrade.\"\n    }\n  }\n}\n","numLines":1141,"startLine":1,"totalLines":1141}}}
