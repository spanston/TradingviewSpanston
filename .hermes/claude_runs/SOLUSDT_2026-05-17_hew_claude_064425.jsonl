{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JA5Sk8wy4wWvMjVjnoXGs4","type":"tool_result","content":"1\t//@version=5\n2\tindicator(\"Konsili Pivot Exporter\", overlay=true, max_labels_count=500)\n3\t\n4\tleftBars = input.int(5, \"Left bars\", minval=1)\n5\trightBars = input.int(5, \"Right bars\", minval=1)\n6\tmaxRows = input.int(24, \"Export rows\", minval=6, maxval=80)\n7\tshowTable = input.bool(true, \"Show export table\")\n8\tshowLabels = input.bool(true, \"Show pivot labels\")\n9\t\n10\tvar table exportTable = table.new(position.top_right, 1, maxRows + 1, bgcolor=color.new(color.black, 5), border_width=1)\n11\tvar array<string> exportRows = array.new_string()\n12\tvar array<label> pivotLabels = array.new_label()\n13\t\n14\tmakeRow(string pivotType, float price, int pivotTime) =>\n15\t    pivotId = str.format(\"{0}_{1}_{2}\", timeframe.period, str.tostring(pivotTime), pivotType == \"high\" ? \"H\" : \"L\")\n16\t    pivotDate = str.format_time(pivotTime, \"yyyy-MM-dd HH:mm\", syminfo.timezone)\n17\t    str.format(\n18\t      \"KPE|v=2|tf={0}|id={1}|type={2}|date={3}|time={4}|price={5}|timezone={6}|left={7}|right={8}|confirmed=true\",\n19\t      timeframe.period,\n20\t      pivotId,\n21\t      pivotType,\n22\t      pivotDate,\n23\t      str.tostring(pivotTime),\n24\t      str.tostring(price, format.mintick),\n25\t      syminfo.timezone,\n26\t      str.tostring(leftBars),\n27\t      str.tostring(rightBars))\n28\t\n29\trecordPivot(string pivotType, float price, int pivotTime) =>\n30\t    row = makeRow(pivotType, price, pivotTime)\n31\t    array.push(exportRows, row)\n32\t    if showLabels\n33\t        labelStyle = pivotType == \"high\" ? label.style_label_down : label.style_label_up\n34\t        labelColor = pivotType == \"high\" ? color.new(color.red, 0) : color.new(color.green, 0)\n35\t        newLabel = label.new(\n36\t          x=pivotTime,\n37\t          y=price,\n38\t          text=row,\n39\t          xloc=xloc.bar_time,\n40\t          yloc=yloc.price,\n41\t          style=labelStyle,\n42\t          color=labelColor,\n43\t          textcolor=color.white,\n44\t          size=size.tiny)\n45\t        array.push(pivotLabels, newLabel)\n46\t    while array.size(exportRows) > maxRows\n47\t        array.shift(exportRows)\n48\t    while array.size(pivotLabels) > maxRows\n49\t        oldLabel = array.shift(pivotLabels)\n50\t        label.delete(oldLabel)\n51\t\n52\tpivotHigh = ta.pivothigh(high, leftBars, rightBars)\n53\tpivotLow = ta.pivotlow(low, leftBars, rightBars)\n54\t\n55\tif not na(pivotHigh)\n56\t    recordPivot(\"high\", pivotHigh, time[rightBars])\n57\t\n58\tif not na(pivotLow)\n59\t    recordPivot(\"low\", pivotLow, time[rightBars])\n60\t\n61\tif showTable and barstate.islast\n62\t    table.cell(exportTable, 0, 0, \"Konsili Pivot Exporter v2\", text_color=color.white, bgcolor=color.new(color.blue, 15))\n63\t    for rowIndex = 0 to maxRows - 1\n64\t        sourceIndex = array.size(exportRows) - maxRows + rowIndex\n65\t        rowText = sourceIndex >= 0 ? array.get(exportRows, sourceIndex) : \"\"\n66\t        table.cell(exportTable, 0, rowIndex + 1, rowText, text_color=color.white, bgcolor=color.new(color.black, 0))\n67\t"}]},"parent_tool_use_id":null,"session_id":"044a7eb1-7910-460e-8c7a-cffc70659e59","uuid":"8916b284-1c32-45ef-b32b-bfa965d1de0b","timestamp":"2026-05-17T04:45:24.345Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Johan\\Desktop\\KonsiliTradingview\\tradingview\\konsili_pivot_exporter.pine","content":"//@version=5\nindicator(\"Konsili Pivot Exporter\", overlay=true, max_labels_count=500)\n\nleftBars = input.int(5, \"Left bars\", minval=1)\nrightBars = input.int(5, \"Right bars\", minval=1)\nmaxRows = input.int(24, \"Export rows\", minval=6, maxval=80)\nshowTable = input.bool(true, \"Show export table\")\nshowLabels = input.bool(true, \"Show pivot labels\")\n\nvar table exportTable = table.new(position.top_right, 1, maxRows + 1, bgcolor=color.new(color.black, 5), border_width=1)\nvar array<string> exportRows = array.new_string()\nvar array<label> pivotLabels = array.new_label()\n\nmakeRow(string pivotType, float price, int pivotTime) =>\n    pivotId = str.format(\"{0}_{1}_{2}\", timeframe.period, str.tostring(pivotTime), pivotType == \"high\" ? \"H\" : \"L\")\n    pivotDate = str.format_time(pivotTime, \"yyyy-MM-dd HH:mm\", syminfo.timezone)\n    str.format(\n      \"KPE|v=2|tf={0}|id={1}|type={2}|date={3}|time={4}|price={5}|timezone={6}|left={7}|right={8}|confirmed=true\",\n      timeframe.period,\n      pivotId,\n      pivotType,\n      pivotDate,\n      str.tostring(pivotTime),\n      str.tostring(price, format.mintick),\n      syminfo.timezone,\n      str.tostring(leftBars),\n      str.tostring(rightBars))\n\nrecordPivot(string pivotType, float price, int pivotTime) =>\n    row = makeRow(pivotType, price, pivotTime)\n    array.push(exportRows, row)\n    if showLabels\n        labelStyle = pivotType == \"high\" ? label.style_label_down : label.style_label_up\n        labelColor = pivotType == \"high\" ? color.new(color.red, 0) : color.new(color.green, 0)\n        newLabel = label.new(\n          x=pivotTime,\n          y=price,\n          text=row,\n          xloc=xloc.bar_time,\n          yloc=yloc.price,\n          style=labelStyle,\n          color=labelColor,\n          textcolor=color.white,\n          size=size.tiny)\n        array.push(pivotLabels, newLabel)\n    while array.size(exportRows) > maxRows\n        array.shift(exportRows)\n    while array.size(pivotLabels) > maxRows\n        oldLabel = array.shift(pivotLabels)\n        label.delete(oldLabel)\n\npivotHigh = ta.pivothigh(high, leftBars, rightBars)\npivotLow = ta.pivotlow(low, leftBars, rightBars)\n\nif not na(pivotHigh)\n    recordPivot(\"high\", pivotHigh, time[rightBars])\n\nif not na(pivotLow)\n    recordPivot(\"low\", pivotLow, time[rightBars])\n\nif showTable and barstate.islast\n    table.cell(exportTable, 0, 0, \"Konsili Pivot Exporter v2\", text_color=color.white, bgcolor=color.new(color.blue, 15))\n    for rowIndex = 0 to maxRows - 1\n        sourceIndex = array.size(exportRows) - maxRows + rowIndex\n        rowText = sourceIndex >= 0 ? array.get(exportRows, sourceIndex) : \"\"\n        table.cell(exportTable, 0, rowIndex + 1, rowText, text_color=color.white, bgcolor=color.new(color.black, 0))\n","numLines":67,"startLine":1,"totalLines":67}}}
