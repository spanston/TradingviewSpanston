"mcp__tradingview__pane_set_symbol","mcp__tradingview__pine_analyze","mcp__tradingview__pine_check","mcp__tradingview__pine_compile","mcp__tradingview__pine_get_console","mcp__tradingview__pine_get_errors","mcp__tradingview__pine_get_source","mcp__tradingview__pine_list_scripts","mcp__tradingview__pine_new","mcp__tradingview__pine_open","mcp__tradingview__pine_save","mcp__tradingview__pine_set_source","mcp__tradingview__pine_smart_compile","mcp__tradingview__quote_get","mcp__tradingview__replay_autoplay","mcp__tradingview__replay_start","mcp__tradingview__replay_status","mcp__tradingview__replay_step","mcp__tradingview__replay_stop","mcp__tradingview__replay_trade","mcp__tradingview__symbol_info","mcp__tradingview__symbol_search","mcp__tradingview__tab_close","mcp__tradingview__tab_list","mcp__tradingview__tab_new","mcp__tradingview__tab_switch","mcp__tradingview__tv_discover","mcp__tradingview__tv_health_check","mcp__tradingview__tv_launch","mcp__tradingview__tv_ui_state","mcp__tradingview__ui_click","mcp__tradingview__ui_evaluate","mcp__tradingview__ui_find_element","mcp__tradingview__ui_fullscreen","mcp__tradingview__ui_hover","mcp__tradingview__ui_keyboard","mcp__tradingview__ui_mouse_click","mcp__tradingview__ui_open_panel","mcp__tradingview__ui_scroll","mcp__tradingview__ui_type_text","mcp__tradingview__watchlist_add","mcp__tradingview__watchlist_get"],"mcp_servers":[{"name":"plugin:context7:context7","status":"pending"},{"name":"plugin:playwright:playwright","status":"pending"},{"name":"Neon","status":"connected"},{"name":"tradingview","status":"connected"},{"name":"claude.ai Google Drive","status":"needs-auth"}],"model":"claude-opus-4-7","permissionMode":"bypassPermissions","slash_commands":["playwright-cli","code-review:code-review","frontend-design:frontend-design","update-config","debug","simplify","batch","fewer-permission-prompts","loop","schedule","claude-api","clear","compact","context","heapdump","init","review","security-review","extra-usage","usage