    var tcOuter = pc.dwgtablecells;\n46\t              if (tcOuter) {\n47\t                var tcColl = tcOuter.get('tableCells');\n48\t                if (tcColl && tcColl._primitivesDataById && tcColl._primitivesDataById.size > 0) {\n49\t                  tcColl._primitivesDataById.forEach(function(v, id) { items.push({id: id, raw: v}); });\n50\t                }\n51\t              }\n52\t            } catch(e) {}\n53\t          }\n54\t          if (items.length > 0) results.push({name: name, count: items.length, items: items});\n55\t        } catch(e) {}\n56\t      }\n57\t      return results;\n58\t    })()\n59\t  `;\n60\t}\n61\t\n62\texport async function getOhlcv({ count, summary } = {}) {\n63\t  const limit = Math.min(count || 100, MAX_OHLCV_BARS);\n64\t  let data;\n65\t  try {\n66\t    data = await evaluate(`\n67\t      (function() {\n68\t        var bars = ${BARS_PATH};\n69\t        if (!bars || typeof bars.lastIndex !== 'function') return null;\n70\t        var result = [];\n71\t        var end = bars.lastIndex();\n72\t        var start = Math.max(bars.firstIndex(), end - ${limit} + 1);\n73\t        for (var i = start; i <= end; i++) {\n74\t          var v = bars.valueAt(i);\n75\t          if (v) result.push({time: v[0], open: v[1], high: v[2], low: v[3], close: v[4], volume: v[5] || 0});\n76\t        }\n77\t        return {bars: result, total_bars: bars.size(), source: 'direct_bars'};\n78\t      })()\n79\t    `);\n80\t  } catch { data = null; }\n81\t\n82\t  if (!data || !data.bars || data.bars.length === 0) {\n83\t    throw new Error('Could not extract OHLCV data. The chart may still be loading.');\n84\t  }\n85\t\n86\t  if (summary) {\n87\t    const bars = data.bars;\n88\t    const highs = bars.map(b => b.high);\n89\t    const lows = bars.map(b => b.low);\n90\t    const volumes = bars.map(b => b.volume);\n91\t    const first = bars[0];\n92\t    const last = bars[bars.length - 1];\n93\t    return {\n94\t      success: true, bar_count: bars.length,\n95\t      period: { from: first.time, to: last.time },\n96\t      open: first.open, close: last.close,\n97\t      high: Math.max(...highs), low: Math.min(...lows),\n98\t      range: Math.round((Math.max(...highs) - Math.min(...lows)) * 100) / 100,\n99\t      change: Math.round((last.close - first.open) * 100) / 100,\n100\t      change_pct: Math.round(((last.close - first.open) / first.open) * 10000) / 100 + '%',\n101\t      avg_volume: Math.round(volumes.reduce((a, b) => a + b, 0) / volumes.length),\n102\t      last_5_bars: bars.slice(-5),\n103\t    };\n104\t  }\n105\t\n106\t  return { success: true, bar_count: data.bars.length, total_available: data.total_bars, source: data.source, bars: data.bars };\n107\t}\n108\t\n109\texport async function getIndicator({ entity_id }) {\n110\t  const data = await evaluate(`\n111\t    (function() {\n112\t      var api = ${CHART_API};\n113\t      var study = api.getStudyById(${safeString(entity_id)});\n114\t      if (!study) return { error: 'Study not found: ' + ${safeString(entity_id)} };\n115\t      var result = { name: null, inputs: null, visible: null };\n116\t      try { result.visible = study.isVisible(); } catch(e) {}\n117\t      try { result.inputs = study.getInputValues(); } catch(e) { result.inputs_error = e.message; }\n118\t      return result;\n119\t    })()\n120\t  `);\n121\t\n122\t  if (data?.error) throw new Error(data.error);\n123\t\n124\t  let inputs = data?.inputs;\n125\t  if (Array.isArray(inputs)) {\n126\t    inputs = inputs.filter(inp => {\n127\t      if (inp.id === 'text' && typeof inp.value === 'string' && inp.value.length > 200) return false;\n128\t      if (typeof inp.value === 'string' && inp.value.length > 500) return false;\n129\t      return true;\n130\t    });\n131\t  }\n132\t  return { success: true, entity_id, visible: data?.visible, inputs };\n133\t}\n134\t\n135\texport async function getStrategyResults() {\n136\t  const results = await evaluate(`\n137\t    (function() {\n138\t      try {\n139\t        var 