: v[3],\n106\t        close: v[4],\n107\t        volume: v[5] || 0,\n108\t        bar_index: last,\n109\t      };\n110\t    })()\n111\t  `);\n112\t}\n113\t\n114\texport async function streamBars({ interval } = {}) {\n115\t  return pollLoop(fetchLastBar, { interval: interval || 500, label: 'bars' });\n116\t}\n117\t\n118\t// ── Stream: indicator values ──\n119\t\n120\tasync function fetchValues() {\n121\t  return evaluate(`\n122\t    (function() {\n123\t      var chart = ${CHART_API};\n124\t      var m = ${MODEL};\n125\t      var studies = chart.getAllStudies();\n126\t      var results = [];\n127\t      for (var i = 0; i < studies.length; i++) {\n128\t        try {\n129\t          var study = chart.getStudyById(studies[i].id);\n130\t          if (!study || !study.isVisible()) continue;\n131\t          var src = study._study || study;\n132\t          var data = src._lastBarValues || src._data;\n133\t          if (!data) continue;\n134\t          var vals = {};\n135\t          if (typeof data === 'object') {\n136\t            for (var k in data) {\n137\t              if (typeof data[k] === 'number' && !isNaN(data[k])) vals[k] = data[k];\n138\t            }\n139\t          }\n140\t          if (Object.keys(vals).length > 0) results.push({ name: studies[i].name, values: vals });\n141\t        } catch(e) {}\n142\t      }\n143\t      return { symbol: chart.symbol(), study_count: results.length, studies: results };\n144\t    })()\n145\t  `);\n146\t}\n147\t\n148\texport async function streamValues({ interval } = {}) {\n149\t  return pollLoop(fetchValues, { interval: interval || 500, label: 'values' });\n150\t}\n151\t\n152\t// ── Stream: pine lines ──\n153\t\n154\tasync function fetchLines(studyFilter) {\n155\t  const filter = studyFilter ? JSON.stringify(studyFilter) : 'null';\n156\t  return evaluate(`\n157\t    (function() {\n158\t      var filter = ${filter};\n159\t      var chart = ${CHART_API};\n160\t      var studies = chart.getAllStudies();\n161\t      var results = [];\n162\t      for (var i = 0; i < studies.length; i++) {\n163\t        var s = studies[i];\n164\t        if (filter && (s.name || '').toLowerCase().indexOf(filter.toLowerCase()) === -1) continue;\n165\t        try {\n166\t          var study = chart.getStudyById(s.id);\n167\t          if (!study) continue;\n168\t          var src = study._study || study;\n169\t          var g = src._graphics || (src._source && src._source._graphics);\n170\t          if (!g) continue;\n171\t          var pc = g._primitivesCollection;\n172\t          if (!pc || !pc.dwglines) continue;\n173\t          var linesMap = pc.dwglines.get('lines');\n174\t          if (!linesMap) continue;\n175\t          var data = linesMap.get(false);\n176\t          if (!data || !data._primitivesDataById) continue;\n177\t          var levels = [];\n178\t          var seen = {};\n179\t          data._primitivesDataById.forEach(function(line) {\n180\t            var p1 = line.points && line.points[0] ? line.points[0].price : null;\n181\t            var p2 = line.points && line.points[1] ? line.points[1].price : null;\n182\t            var price = (p1 !== null && p1 === p2) ? p1 : (p1 || p2);\n183\t            if (price !== null && !seen[price]) { seen[price] = true; levels.push(price); }\n184\t          });\n185\t          levels.sort(function(a, b) { return b - a; });\n186\t          if (levels.length > 0) results.push({ study: s.name, levels: levels });\n187\t        } catch(e) {}\n188\t      }\n189\t      return { symbol: chart.symbol(), study_count: results.length, studies: results };\n190\t    })()\n191\t  `);\n192\t}\n193\t\n194\texport async function streamLines({ interval, filter } = {}) {\n195\t  return pollLoop(() => fetchLines(filter), { interval: interval || 1000, label: 'lines' });\n196\t}\n197\t\n198\t// ── Stream: pine labels ──\n199\t\n200\tasync function fetchLabels(studyFilter) {\n201\t  const filterStr = studyFilter ? JSON.stringify(studyFilter) : 'null';\n202\t  return evaluate(`\n203\t    