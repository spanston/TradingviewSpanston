{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MAFrYG3FovE75qHXrVoN6v","type":"tool_result","content":"1\t/**\n2\t * Core streaming logic — real-time JSONL output from TradingView.\n3\t * Uses efficient poll + dedup: only emits when data changes.\n4\t */\n5\timport { evaluate } from '../connection.js';\n6\t\n7\tconst CHART_API = 'window.TradingViewApi._activeChartWidgetWV.value()';\n8\tconst MODEL = `${CHART_API}._chartWidget.model()`;\n9\t\n10\t/**\n11\t * Generic poll-and-diff loop.\n12\t * Calls fetcher(), compares to last value, emits JSONL on change.\n13\t * Writes to stdout directly for pipe-friendliness.\n14\t */\n15\tasync function pollLoop(fetcher, { interval = 500, dedupe = true, label = 'stream' } = {}) {\n16\t  let lastHash = null;\n17\t  let running = true;\n18\t\n19\t  const cleanup = () => { running = false; };\n20\t  process.on('SIGINT', cleanup);\n21\t  process.on('SIGTERM', cleanup);\n22\t\n23\t  // Emit header with compliance notice\n24\t  const start = Date.now();\n25\t  process.stderr.write(`\\u26A0  tradingview-mcp  |  Unofficial tool. Not affiliated with TradingView Inc. or Anthropic.\\n`);\n26\t  process.stderr.write(`   Streams from your locally running TradingView Desktop instance only.\\n`);\n27\t  process.stderr.write(`   Does not connect to TradingView servers. Requires --remote-debugging-port=9222.\\n`);\n28\t  process.stderr.write(`   Ensure your usage complies with TradingView's Terms of Use.\\n`);\n29\t  process.stderr.write(`[stream:${label}] started, interval=${interval}ms, Ctrl+C to stop\\n`);\n30\t\n31\t  while (running) {\n32\t    try {\n33\t      const data = await fetcher();\n34\t      if (!data) { await sleep(interval); continue; }\n35\t\n36\t      const hash = dedupe ? JSON.stringify(data) : null;\n37\t      if (!dedupe || hash !== lastHash) {\n38\t        lastHash = hash;\n39\t        const line = JSON.stringify({ ...data, _ts: Date.now(), _stream: label });\n40\t        process.stdout.write(line